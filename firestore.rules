rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Only a trusted Firebase Admin SDK can issue this custom claim.
    // There is intentionally no client-side admin role field.
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function publicPath(uid) { return /databases/$(database)/documents/publicProfiles/$(uid); }
    function threadPath(tid) { return /databases/$(database)/documents/threads/$(tid); }
    function messagePath(tid, mid) { return /databases/$(database)/documents/threads/$(tid)/messages/$(mid); }

    function validHandle(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$')
        && !(name in ['admin','administrator','moderator','mod','staff','support',
          'system','owner','root','security','firebase','official','null']);
    }
    function validAvatar(data) {
      return data is string && data.size() <= 48000
        && (data == '' || data.matches('^data:image/(webp|png);base64,[A-Za-z0-9+/=]+$'));
    }
    function handleAfter(name, uid) {
      return getAfter(/databases/$(database)/documents/handles/$(name)).data.uid == uid;
    }
    function privateValid(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['uid','displayName','email','photoURL','createdAt','updatedAt'])
        && d.keys().hasOnly(['uid','displayName','email','photoURL','createdAt',
          'updatedAt','avatarData','username','bio','isPublic'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 60
        && d.email is string && d.email == request.auth.token.email && d.email.size() <= 254
        && d.photoURL is string && d.photoURL.size() <= 2000
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && (!d.keys().hasAny(['avatarData']) || validAvatar(d.avatarData))
        && (!d.keys().hasAny(['username']) || (validHandle(d.username) && handleAfter(d.username, uid)))
        && (!d.keys().hasAny(['bio']) || (d.bio is string && d.bio.size() <= 180))
        && (!d.keys().hasAny(['isPublic']) || d.isPublic is bool);
    }
    // Prevent stale public records surviving a privacy switch or private edit.
    function publicStateAfter(uid) {
      let d = request.resource.data;
      return d.get('isPublic', false)
        ? (existsAfter(publicPath(uid))
          && getAfter(publicPath(uid)).data.displayName == d.displayName
          && getAfter(publicPath(uid)).data.username == d.username
          && getAfter(publicPath(uid)).data.bio == d.get('bio', '')
          && getAfter(publicPath(uid)).data.avatarData == d.get('avatarData', ''))
        : !existsAfter(publicPath(uid));
    }
    function publicValid(uid) {
      let d = request.resource.data;
      let p = getAfter(userPath(uid)).data;
      return d.keys().hasAll(['uid','username','displayName','bio','avatarData','joinedAt'])
        && d.keys().hasOnly(['uid','username','displayName','bio','avatarData','joinedAt'])
        && d.uid == uid && p.get('isPublic', false) == true
        && d.username == p.username && validHandle(d.username)
        && handleAfter(d.username, uid)
        && d.displayName == p.displayName
        && d.bio == p.get('bio', '')
        && validAvatar(d.avatarData)
        && d.avatarData == p.get('avatarData','')
        && d.joinedAt == p.createdAt;
    }

    // Private identity and email; admins may VIEW a limited roster, not edit users.
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin() && request.query.limit <= 30;
      allow create: if owner(uid) && privateValid(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && privateValid(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['displayName','username','bio','isPublic','avatarData','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && publicStateAfter(uid)
        && (!resource.data.keys().hasAny(['username'])
          || resource.data.username == request.resource.data.get('username','')
          || !existsAfter(/databases/$(database)/documents/handles/$(resource.data.username)));
      allow delete: if false;
    }

    // Username reservation: no enumeration and no takeovers.
    match /handles/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validHandle(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.username == name;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.get('username','') != name;
    }

    // Only users who opt in publish cards in this collection.
    // Search queries must be bounded; private users aren't indexed.
    match /publicProfiles/{uid} {
      allow get: if get(userPath(uid)).data.get('isPublic',false) == true;
      allow list: if request.query.limit <= 15;
      allow create, update: if owner(uid) && publicValid(uid);
      allow delete: if owner(uid);
    }

    // A personal block list. Chat sends check BOTH directions.
    match /blocks/{uid}/targets/{targetUid} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 50;
      allow create: if owner(uid) && targetUid != uid
        && request.resource.data.keys().hasOnly(['blockedAt'])
        && request.resource.data.blockedAt == request.time;
      allow update: if false;
      allow delete: if owner(uid);
    }
    function notBlocked(a, b) {
      return !exists(/databases/$(database)/documents/blocks/$(a)/targets/$(b))
        && !exists(/databases/$(database)/documents/blocks/$(b)/targets/$(a));
    }
    function otherMember(members, sender) {
      return members[0] == sender ? members[1] : members[0];
    }
    function validThread(tid) {
      let d = request.resource.data;
      return d.keys().hasAll(['members','createdBy','createdAt','updatedAt',
        'lastMessage','lastMessageId','lastSenderUid','lastSentAt'])
        && d.keys().hasOnly(['members','createdBy','createdAt','updatedAt',
          'lastMessage','lastMessageId','lastSenderUid','lastSentAt'])
        && d.members is list && d.members.size() == 2
        && d.members[0] is string && d.members[1] is string
        && d.members[0] != d.members[1]
        && tid == d.members[0] + '_' + d.members[1]
        && request.auth.uid in d.members
        && d.lastSenderUid == request.auth.uid
        && d.lastMessage is string
        && d.lastMessage.size() >= 1 && d.lastMessage.size() <= 700
        && d.lastMessageId is string && d.lastMessageId.size() <= 150
        && d.createdBy is string
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.lastSentAt is timestamp;
    }
    function linkedMessage(tid) {
      let d = request.resource.data;
      let m = getAfter(messagePath(tid,d.lastMessageId)).data;
      return m.senderUid == request.auth.uid
        && m.body == d.lastMessage && m.createdAt == request.time;
    }
    function threadParticipants(tid) {
      return signedIn() && request.auth.uid in get(threadPath(tid)).data.members;
    }
    function canSend(tid, mid) {
      let t = getAfter(threadPath(tid)).data;
      return request.auth.uid in t.members
        && notBlocked(t.members[0],t.members[1])
        && t.lastMessageId == mid
        && t.lastSenderUid == request.auth.uid
        && t.lastMessage == request.resource.data.body
        && t.lastSentAt == request.time;
    }

    match /threads/{tid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if signedIn() && request.query.limit <= 30
        && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validThread(tid)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSentAt == request.time
        && exists(publicPath(otherMember(request.resource.data.members,request.auth.uid)))
        && notBlocked(request.resource.data.members[0],request.resource.data.members[1])
        && linkedMessage(tid);
      allow update: if signedIn() && validThread(tid)
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastMessageId','lastSenderUid','lastSentAt','updatedAt'
        ])
        && request.resource.data.lastMessageId != resource.data.lastMessageId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSentAt == request.time
        && notBlocked(resource.data.members[0],resource.data.members[1])
        && linkedMessage(tid);
      allow delete: if false;

      match /messages/{mid} {
        allow get: if threadParticipants(tid);
        allow list: if threadParticipants(tid) && request.query.limit <= 40;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderUid','body','createdAt'])
          && request.resource.data.keys().hasAll(['senderUid','body','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 700
          && request.resource.data.createdAt == request.time
          && canSend(tid,mid);
        allow update, delete: if false;
      }
    }

    // The sender can create an alert only alongside a legitimate message,
    // for that message's other participant. Users manage only their own alerts.
    match /notifications/{uid}/items/{mid} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 50;
      allow create: if signedIn() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type','fromUid','threadId','messageId','createdAt','read'
        ])
        && request.resource.data.keys().hasAll([
          'type','fromUid','threadId','messageId','createdAt','read'
        ])
        && request.resource.data.type == 'message'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.messageId == mid
        && request.resource.data.threadId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && uid in getAfter(threadPath(request.resource.data.threadId)).data.members
        && request.auth.uid in getAfter(threadPath(request.resource.data.threadId)).data.members
        && getAfter(messagePath(request.resource.data.threadId,mid)).data.senderUid == request.auth.uid
        && getAfter(messagePath(request.resource.data.threadId,mid)).data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if owner(uid);
    }

    // These are personal, client-written activity markers, NOT a trusted audit trail.
    match /activity/{uid}/events/{eventId} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 50;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['kind','details','createdAt'])
        && request.resource.data.keys().hasAll(['kind','details','createdAt'])
        && request.resource.data.kind in [
          'session_opened','profile_updated','theme_changed',
          'password_changed','message_sent','message_read',
          'calendar_created','calendar_updated','calendar_deleted',
          'task_created','task_updated','task_deleted','group_joined'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owner(uid);
    }

    // Each calendar is private to its authenticated owner.
    function validCalendarEvent() {
      let e = request.resource.data;
      return e.keys().hasAll([
          'title','day','allDay','startTime','endTime','category',
          'location','description','createdAt','updatedAt'
        ])
        && e.keys().hasOnly([
          'title','day','allDay','startTime','endTime','category',
          'location','description','createdAt','updatedAt'
        ])
        && e.title is string && e.title.size() >= 1 && e.title.size() <= 90
        && e.day is string && e.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && e.allDay is bool
        && e.startTime is string && e.endTime is string
        && (e.allDay
          ? (e.startTime == '' && e.endTime == '')
          : (e.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && e.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && e.endTime > e.startTime))
        && e.category in ['personal','school','work','other']
        && e.location is string && e.location.size() <= 120
        && e.description is string && e.description.size() <= 1000
        && e.createdAt is timestamp && e.updatedAt is timestamp;
    }

    match /calendars/{uid}/events/{eventId} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 250;
      allow create: if owner(uid) && validCalendarEvent()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && validCalendarEvent()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','day','allDay','startTime','endTime',
          'category','location','description','updatedAt'
        ]);
      allow delete: if owner(uid);
    }

    // Social access helpers. Server-issued admin claim and staffRole only.
    function staff() {
      return admin() || (signedIn()
        && request.auth.token.get('staffRole','') in ['owner','admin','moderator','support']);
    }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function channelPath(gid,cid) {
      return /databases/$(database)/documents/groups/$(gid)/channels/$(cid);
    }
    function invitePath(gid,uid) {
      return /databases/$(database)/documents/groupInvites/$(gid + '_' + uid);
    }
    function groupMember(gid) {
      return signedIn() && exists(groupPath(gid))
        && request.auth.uid in get(groupPath(gid)).data.members;
    }
    function groupOwner(gid) {
      return signedIn() && exists(groupPath(gid))
        && get(groupPath(gid)).data.ownerUid == request.auth.uid;
    }
    function invitedMember(gid,uid) {
      return signedIn() && exists(invitePath(gid,uid))
        && get(invitePath(gid,uid)).data.toUid == uid;
    }
    function canSeeChannel(gid,cid) {
      let c = get(channelPath(gid,cid)).data;
      return groupMember(gid)
        && (c.private == false || request.auth.uid in c.allowedUids || groupOwner(gid));
    }

    // One directional record is maintained for each friend request.
    match /friendRequests/{rid} {
      allow get: if signedIn()
        && request.auth.uid in [resource.data.fromUid,resource.data.toUid];
      allow list: if signedIn() && request.query.limit <= 50
        && request.auth.uid in [resource.data.fromUid,resource.data.toUid];
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['fromUid','toUid','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['fromUid','toUid','status','createdAt','updatedAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.toUid
        && exists(publicPath(request.resource.data.toUid))
        && notBlocked(request.auth.uid,request.resource.data.toUid)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if signedIn()
        && request.auth.uid in [resource.data.fromUid,resource.data.toUid];
    }

    // Groups are private; only members can enumerate groups or their channels.
    function validGroupData() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','description','ownerUid','members','createdAt','updatedAt'])
        && d.keys().hasOnly(['name','description','ownerUid','members','createdAt','updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 45
        && d.description is string && d.description.size() <= 200
        && d.ownerUid is string && d.members is list
        && d.members.size() >= 1 && d.members.size() <= 50
        && d.ownerUid in d.members
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    match /groups/{gid} {
      allow get: if signedIn() && (request.auth.uid in resource.data.members
        || invitedMember(gid,request.auth.uid));
      allow list: if signedIn() && request.query.limit <= 40
        && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validGroupData()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && validGroupData()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.members == resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name','description','updatedAt']))
          || (invitedMember(gid,request.auth.uid)
            && !(request.auth.uid in resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members','updatedAt']))
          || (resource.data.ownerUid != request.auth.uid
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members','updatedAt']))
          || (resource.data.ownerUid == request.auth.uid
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members','updatedAt']))
        );
      allow delete: if false;

      match /channels/{cid} {
        allow get: if groupMember(gid) && (
          resource.data.private == false || request.auth.uid in resource.data.allowedUids
          || groupOwner(gid));
        allow list: if groupMember(gid) && request.query.limit <= 50 && (
          resource.data.private == false || request.auth.uid in resource.data.allowedUids
          || groupOwner(gid));
        allow create: if signedIn()
          && getAfter(groupPath(gid)).data.ownerUid == request.auth.uid
          && request.auth.uid in getAfter(groupPath(gid)).data.members
          && request.resource.data.keys().hasAll([
            'name','private','allowedUids','kind','createdBy','createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name','private','allowedUids','kind','createdBy','createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.matches('^[a-z0-9-]{2,40}$')
          && request.resource.data.private is bool
          && request.resource.data.kind in ['text','incident']
          && request.resource.data.allowedUids is list
          && request.resource.data.allowedUids.size() <= 50
          && request.auth.uid in request.resource.data.allowedUids
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if groupOwner(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedUids'])
          && request.resource.data.allowedUids is list
          && request.resource.data.allowedUids.size() <= 50
          && request.auth.uid in request.resource.data.allowedUids;
        allow delete: if false;

        match /posts/{pid} {
          allow get: if canSeeChannel(gid,cid);
          allow list: if canSeeChannel(gid,cid) && request.query.limit <= 60;
          allow create: if canSeeChannel(gid,cid)
            && request.resource.data.keys().hasAll(['senderUid','body','createdAt'])
            && request.resource.data.keys().hasOnly(['senderUid','body','createdAt'])
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 700
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if groupOwner(gid);
        }
      }
    }

    // Invites are created by the owner and accepted by the invitee only.
    match /groupInvites/{iid} {
      allow get: if signedIn()
        && request.auth.uid in [resource.data.toUid,resource.data.fromUid];
      allow list: if signedIn() && request.query.limit <= 40
        && request.auth.uid in [resource.data.toUid,resource.data.fromUid];
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'groupId','toUid','fromUid','groupName','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'groupId','toUid','fromUid','groupName','createdAt'
        ])
        && request.resource.data.groupId is string
        && request.resource.data.toUid is string
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && iid == request.resource.data.groupId + '_' + request.resource.data.toUid
        && groupOwner(request.resource.data.groupId)
        && !(request.resource.data.toUid in get(groupPath(request.resource.data.groupId)).data.members)
        && request.resource.data.groupName == get(groupPath(request.resource.data.groupId)).data.name
        && exists(publicPath(request.resource.data.toUid))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in [resource.data.toUid,resource.data.fromUid];
    }

    // Reports: reporter and trusted staff only; no group-wide visibility.
    match /reports/{rid} {
      allow get: if signedIn()
        && (staff() || request.auth.uid == resource.data.reporterUid);
      allow list: if signedIn() && request.query.limit <= 40
        && (staff() || request.auth.uid == resource.data.reporterUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'kind','title','details','targetUid','reporterUid','groupId',
          'channelId','status','staffNote','handledBy','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'kind','title','details','targetUid','reporterUid','groupId',
          'channelId','status','staffNote','handledBy','createdAt','updatedAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.kind in ['incident','account','message','other']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 1600
        && request.resource.data.targetUid is string && request.resource.data.targetUid.size() <= 128
        && request.resource.data.groupId is string && request.resource.data.groupId.size() <= 128
        && request.resource.data.channelId is string && request.resource.data.channelId.size() <= 128
        && request.resource.data.status == 'open'
        && request.resource.data.staffNote == '' && request.resource.data.handledBy == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','staffNote','handledBy','updatedAt'
        ])
        && request.resource.data.status in ['open','reviewing','resolved','dismissed']
        && request.resource.data.staffNote is string
        && request.resource.data.staffNote.size() <= 1000
        && request.resource.data.handledBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Personal Kanban and reminders. No other account can see these tasks.
    match /taskBoards/{uid}/items/{tid} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 150;
      allow create: if owner(uid) && validTask()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && validTask()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','description','status','priority','dueDay','remindAt','updatedAt'
        ]);
      allow delete: if owner(uid);
    }
    function validTask() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'title','description','status','priority','dueDay','remindAt','createdAt','updatedAt'
        ])
        && d.keys().hasOnly([
          'title','description','status','priority','dueDay','remindAt','createdAt','updatedAt'
        ])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 1000
        && d.status in ['todo','doing','done']
        && d.priority in ['low','medium','high']
        && d.dueDay is string
        && (d.dueDay == '' || d.dueDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.remindAt == null || d.remindAt is timestamp)
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Private support cases, staff replies stored as internal response notes.
    match /supportTickets/{tid} {
      allow get: if signedIn() && (staff() || request.auth.uid == resource.data.createdBy);
      allow list: if signedIn() && request.query.limit <= 40
        && (staff() || request.auth.uid == resource.data.createdBy);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'createdBy','subject','body','status','staffNote','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'createdBy','subject','body','status','staffNote','createdAt','updatedAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10 && request.resource.data.body.size() <= 2000
        && request.resource.data.status == 'open' && request.resource.data.staffNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','staffNote','updatedAt'
        ])
        && request.resource.data.status in ['open','working','resolved','closed']
        && request.resource.data.staffNote is string
        && request.resource.data.staffNote.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Announcements are public; only trusted admins may publish or edit.
    match /siteAnnouncements/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create: if admin()
        && request.resource.data.keys().hasAll(['title','body','active','createdBy','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['title','body','active','createdBy','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 1000
        && request.resource.data.active is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','body','active','updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 1000
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    // Maintenance and feature flags are informational UI controls, not a
    // trusted mechanism for denying Auth or privileged Firestore operations.
    match /siteConfig/{id} {
      allow get: if id == 'main';
      allow list: if false;
      allow create, update: if id == 'main' && admin()
        && request.resource.data.keys().hasAll([
          'maintenance','message','features','updatedAt','updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'maintenance','message','features','updatedAt','updatedBy'
        ])
        && request.resource.data.maintenance is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.features is map
        && request.resource.data.features.keys().hasOnly(['social','tasks','calendar'])
        && request.resource.data.features.get('social',true) is bool
        && request.resource.data.features.get('tasks',true) is bool
        && request.resource.data.features.get('calendar',true) is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Suspension flags and tamper-resistant audit entries are written by the
    // trusted Admin SDK only. No browser can forge or erase them.
    match /userModeration/{uid} {
      allow get: if owner(uid) || staff();
      allow list: if admin() && request.query.limit <= 50;
      allow create, update, delete: if false;
    }
    match /adminAudit/{id} {
      allow get: if admin();
      allow list: if admin() && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    // Real admin permission is a server-issued Firebase Auth custom claim.
    // Reviews are non-destructive annotations; this is NOT account suspension.
    match /adminReviews/{uid} {
      allow get: if admin();
      allow list: if admin() && request.query.limit <= 30;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['status','note','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['status','note','updatedBy','updatedAt'])
        && request.resource.data.status in ['clear','reviewed','flagged']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
