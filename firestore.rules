rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profileIsValid(uid) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt', 'avatarData'
        ])
        && d.uid == uid
        && d.uid is string
        && d.displayName is string
        && d.displayName.size() <= 60
        && d.email is string
        && d.email == request.auth.token.email
        && d.email.size() <= 254
        && d.photoURL is string
        && d.photoURL.size() <= 2000
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        // Existing user documents may not have an avatarData field yet.
        && (!d.keys().hasAny(['avatarData']) || (
          d.avatarData is string
          && d.avatarData.size() <= 48000
          && (d.avatarData == '' ||
              d.avatarData.matches('^data:image/(webp|png);base64,[A-Za-z0-9+/=]+$'))
        ));
    }

    // Private: only the account owner can read their own document.
    // No public user list, client-controlled admin flags, or other collections.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && profileIsValid(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && profileIsValid(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'avatarData', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
